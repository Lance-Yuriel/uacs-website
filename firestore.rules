rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the requesting user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user has an admin claim or exists in the admins collection
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default: Authenticated users can read their own documents, admins can do anything
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Public collections: read-only for public, write-only for admins
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /memberCount/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Members metadata: authenticated users can read, only admins can write
    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
